---
import Button from "@core-elements/button/Button.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Card from "@wrappers/card/Card.astro";
import GridItem from "@wrappers/grid/GridItem.astro";

type Photo = { source: string; alt?: string };

const {
  name = "",
  price = "",
  description = "",
  photos = [] as Photo[],
  imageSource = "",
  imageAlt = "",
  badge = "",
  enquiryEmail = "",
  enquiryText = "enquire",
  showPhotoGallery = true,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  // Catalogue bookkeeping — used to select products, never rendered.
  id: _id,
  collection: _collection,
  featured: _featured,
  images: _images,
  ...htmlAttributes
} = Astro.props;

/** Pre-fills the customer's mail client so an enquiry only takes one click. */
const enquiryLink = enquiryEmail
  ? `mailto:${enquiryEmail}?subject=${encodeURIComponent(`enquiry: ${name}`)}`
  : "";

/** `photos` is the catalogue path; the single-image props cover inline one-offs. */
const allPhotos: Photo[] =
  photos.length > 0
    ? photos
    : imageSource && String(imageSource).trim() !== ""
      ? [{ source: imageSource, alt: imageAlt }]
      : [];

/** A piece can be listed before it has been photographed. */
const hasPhoto = allPhotos.length > 0;
const shownPhotos = showPhotoGallery ? allPhotos : allPhotos.slice(0, 1);
const isGallery = shownPhotos.length > 1;
---

<GridItem
  class="product-card-item"
  {...htmlAttributes}
>
  <Card
    class:list={["product-card", className]}
    paddingHorizontal="none"
    paddingVertical="none"
    rounded
    backgroundColor="base"
  >
    <div
      class:list={["product-media", !hasPhoto && "is-awaiting-photo"]}
      data-product-gallery={isGallery ? "" : undefined}
    >
      {
        hasPhoto ? (
          <Fragment>
            <div
              class="product-media-track"
              tabindex={isGallery ? "0" : undefined}
              role={isGallery ? "group" : undefined}
              aria-label={isGallery ? `photos of ${name}` : undefined}
            >
              {shownPhotos.map((photo, index) => (
                <div class="product-media-slide">
                  <Image
                    source={photo.source}
                    alt={photo.alt || name}
                    aspectRatio="square"
                    priority={false}
                    sizes="(max-width: 640px) 92vw, 400px"
                    widths={[400, 800]}
                    data-prop-src={index === 0 ? "imageSource" : undefined}
                    data-prop-alt={index === 0 ? "imageAlt" : undefined}
                  />
                </div>
              ))}
            </div>
            {isGallery && (
              <Fragment>
                <button
                  type="button"
                  class="product-media-nav prev"
                  aria-label={`previous photo of ${name}`}
                  hidden
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M15 5 8 12l7 7"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <button
                  type="button"
                  class="product-media-nav next"
                  aria-label={`next photo of ${name}`}
                  hidden
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M9 5l7 7-7 7"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <div class="product-media-dots">
                  {shownPhotos.map((_photo, index) => (
                    <button
                      type="button"
                      class="product-media-dot"
                      aria-label={`photo ${index + 1} of ${shownPhotos.length} of ${name}`}
                      aria-current={index === 0 ? "true" : undefined}
                    />
                  ))}
                </div>
              </Fragment>
            )}
          </Fragment>
        ) : (
          <span
            class="product-photo-pending"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 64 64"
              width="52"
              height="52"
              focusable="false"
            >
              <path
                d="M0 24C0 24 -25 8.5 -25 -8 -25 -16.6 -18.2 -23.5 -9.9 -23.5 -4.4 -23.5 0 -19.8 0 -19.8 0 -19.8 4.4 -23.5 9.9 -23.5 18.2 -23.5 25 -16.6 25 -8 25 8.5 0 24 0 24Z"
                transform="translate(28 33) rotate(-15) scale(0.78)"
                fill="currentColor"
                opacity="0.35"
              />
              <path
                d="M0 24C0 24 -25 8.5 -25 -8 -25 -16.6 -18.2 -23.5 -9.9 -23.5 -4.4 -23.5 0 -19.8 0 -19.8 0 -19.8 4.4 -23.5 9.9 -23.5 18.2 -23.5 25 -16.6 25 -8 25 8.5 0 24 0 24Z"
                transform="translate(36 31) rotate(14) scale(0.78)"
                fill="none"
                stroke="currentColor"
                stroke-width="3.4"
                stroke-linejoin="round"
              />
            </svg>
            <span class="product-photo-pending-label">photo coming soon</span>
          </span>
        )
      }
      {
        badge && (
          <span
            class="product-badge"
            data-editable="text"
            data-prop="badge"
          >
            {badge}
          </span>
        )
      }
    </div>
    <div class="product-body">
      <div class="product-titles">
        <Heading
          class="product-name"
          level="h3"
          size="xs"
          alignmentHorizontal="start"
          data-prop="name"
        >
          {name}
        </Heading>
        <SimpleText
          class="product-price"
          size="sm"
          text={price}
          data-prop="price"
        />
      </div>
      <SimpleText
        class="product-description"
        size="sm"
        text={description}
        data-prop="description"
      />
      {
        enquiryLink && (
          <Button
            class="product-enquire"
            text={enquiryText}
            link={enquiryLink}
            variant="text"
            size="sm"
            iconName="arrow-long-right"
            iconPosition="after"
          />
        )
      }
    </div>
  </Card>
</GridItem>

<style is:global>
  @layer page-sections {
    .product-card-item {
      height: 100%;
    }

    /* Rotation hides the cards it is not showing this visit. */
    .product-card-item[hidden] {
      display: none;
    }

    .product-card {
      height: 100%;

      > .card-inner {
        border: 1px solid var(--color-border-subtle);
        height: 100%;
        overflow: hidden;
        transition:
          transform var(--animation-normal) ease-out,
          box-shadow var(--animation-normal) ease-out;

        &:hover {
          box-shadow: 0 18px 40px -24px rgba(46, 37, 33, 0.35);
          transform: translateY(-3px);
        }

        > .content {
          display: flex;
          flex-direction: column;
          gap: 0;
          height: 100%;
        }
      }
    }

    .product-media {
      background-color: var(--color-bg-accent);
      position: relative;

      &.is-awaiting-photo {
        aspect-ratio: var(--ratio-square);
        display: grid;
        place-items: center;
      }
    }

    /* A horizontal scroll-snap strip: swipeable on touch and scrollable with
       the keyboard on its own, with the buttons below as an enhancement. */
    .product-media-track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      &:focus-visible {
        outline: 2px solid var(--color-focus-ring);
        outline-offset: -2px;
      }
    }

    .product-media-slide {
      flex: 0 0 100%;
      scroll-snap-align: center;
      scroll-snap-stop: always;

      > .image {
        /* Images carry a default top margin; the photo sits flush here. */
        margin-top: 0;
      }

      > .image img {
        display: block;
        width: 100%;
      }
    }

    .product-media-nav {
      align-items: center;
      background-color: color-mix(in srgb, var(--cream-50) 88%, transparent);
      border: 0;
      border-radius: var(--radius-full);
      color: var(--ink-900);
      cursor: pointer;
      display: flex;
      height: 2rem;
      justify-content: center;
      opacity: 0;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      transition:
        opacity var(--animation-normal) ease-in-out,
        background-color var(--animation-normal) ease-in-out;
      width: 2rem;
      z-index: var(--layer-1);

      &.prev {
        inset-inline-start: var(--spacing-sm);
      }

      &.next {
        inset-inline-end: var(--spacing-sm);
      }

      &:hover {
        background-color: var(--cream-50);
      }

      &:disabled {
        cursor: default;
        opacity: 0 !important;
      }
    }

    /* Revealed on hover, and always for anyone navigating by keyboard or touch. */
    .product-card:hover .product-media-nav:not(:disabled),
    .product-media:focus-within .product-media-nav:not(:disabled) {
      opacity: 1;
    }

    @media (hover: none) {
      .product-media-nav:not(:disabled) {
        opacity: 1;
      }
    }

    /* The dots sit on their own scrim: photographs here are mostly white, and
       pale dots vanished against them. */
    .product-media-dots {
      backdrop-filter: blur(4px);
      background-color: color-mix(in srgb, var(--ink-900) 42%, transparent);
      border-radius: var(--radius-full);
      bottom: var(--spacing-sm);
      display: flex;
      gap: 0.3rem;
      inset-inline: 0;
      justify-content: center;
      margin-inline: auto;
      padding: 0.3rem 0.4rem;
      position: absolute;
      width: fit-content;
      z-index: var(--layer-1);
    }

    .product-media-dot {
      background-color: color-mix(in srgb, var(--cream-50) 45%, transparent);
      border: 0;
      border-radius: var(--radius-full);
      cursor: pointer;
      height: 0.45rem;
      padding: 0;
      transition: background-color var(--animation-normal) ease-in-out;
      width: 0.45rem;

      &[aria-current="true"] {
        background-color: var(--cream-50);
      }

      &:focus-visible {
        outline: 2px solid var(--cream-50);
        outline-offset: 2px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .product-media-nav,
      .product-media-dot {
        transition: none;
      }
    }

    .product-photo-pending {
      align-items: center;
      color: var(--color-brand-muted);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .product-photo-pending-label {
      font-size: var(--font-size-xs);
      letter-spacing: 0.08em;
    }

    .product-badge {
      background-color: var(--rose-400);
      border-radius: var(--radius-full);
      color: var(--ink-900);
      font-size: var(--font-size-xs);
      font-weight: 600;
      inset-block-start: var(--spacing-md);
      inset-inline-start: var(--spacing-md);
      letter-spacing: 0.04em;
      padding-block: 0.35em;
      padding-inline: 0.85em;
      position: absolute;
      z-index: var(--layer-1);
    }

    .product-body {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      gap: var(--spacing-sm);
      padding: var(--spacing-lg);
    }

    .product-titles {
      align-items: baseline;
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs) var(--spacing-md);
      justify-content: space-between;

      > .product-name {
        margin: 0;
      }
    }

    .product-price {
      color: var(--color-brand);
      font-weight: 600;
      margin: 0;
      white-space: nowrap;
    }

    .product-description {
      color: var(--color-text-muted);
      margin: 0;
    }

    .product-enquire {
      margin-top: auto;
      padding-top: var(--spacing-sm);

      > .button-inner {
        font-size: var(--font-size-sm);
      }
    }
  }
</style>
