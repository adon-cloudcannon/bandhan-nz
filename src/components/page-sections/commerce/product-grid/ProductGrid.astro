---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import { productPhotos, selectProducts, type Product } from "@utils/products";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Grid from "@wrappers/grid/Grid.astro";
import ProductCard from "./ProductCard.astro";
import ProductGalleryScript from "./ProductGalleryScript.astro";
import ProductRotationScript from "./ProductRotationScript.astro";

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  collectionId = "",
  featuredOnly = false,
  productIds = [] as string[],
  products = [] as Product[],
  limit = 0,
  randomize = false,
  enquiryEmail = "",
  enquiryText = "enquire",
  showPhotoGallery = true,
  footnote = "",
  buttonSections = [],
  minItemWidth = 280,
  maxItemWidth = 400,
  gap = "lg",
  alignmentHorizontal = "center",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const pool = selectProducts({ products, productIds, collectionId, featuredOnly });
const shown = limit > 0 ? Math.min(limit, pool.length) : pool.length;

/**
 * When rotating, the whole pool is rendered and all but `shown` are hidden, so
 * a small inline script can reshuffle on each visit. Capped so a large
 * catalogue cannot quietly balloon the page — and the build says so rather
 * than dropping products silently.
 */
const ROTATION_POOL_MAX = 24;

if (randomize && pool.length > ROTATION_POOL_MAX) {
  console.warn(
    `[product-grid] ${pool.length} products match this rotating section but only the first ${ROTATION_POOL_MAX} can appear. Narrow the selection, or raise ROTATION_POOL_MAX in ProductGrid.astro.`
  );
}

const rendered = randomize ? pool.slice(0, ROTATION_POOL_MAX) : pool.slice(0, shown);

/** Build-time pick. Also what a visitor without JavaScript sees. */
const visible = new Set<number>();

if (randomize && shown < rendered.length) {
  const order = rendered.map((_, index) => index);

  for (let i = order.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));

    [order[i], order[j]] = [order[j], order[i]];
  }

  order.slice(0, shown).forEach((index) => visible.add(index));
} else {
  rendered.forEach((_, index) => visible.add(index));
}

const isRotating = randomize && shown < rendered.length;

/** Only ship the photo-switcher script if some card actually has a set. */
const hasPhotoGallery =
  showPhotoGallery && rendered.some((product) => productPhotos(product).length > 1);
---

<CustomSection
  class:list={["product-grid", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  background={background}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal={alignmentHorizontal}
    class="eyebrow"
    data-prop="eyebrow"
    text={eyebrow}
  />
  <Heading
    level="h2"
    size="lg"
    alignmentHorizontal={alignmentHorizontal}
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Text
    class="product-grid-subtext subtext"
    alignmentHorizontal={alignmentHorizontal}
    data-prop="subtext"
    text={subtext}
  />
  <Grid
    gap={gap}
    layout="start"
    minItemWidth={minItemWidth}
    maxItemWidth={maxItemWidth}
    class="product-grid-grid"
    data-children-prop="products"
    data-product-rotate={isRotating ? String(shown) : undefined}
  >
    {
      rendered.map((product: Product, index: number) => (
        <ProductCard
          data-id="page-sections/commerce/product-grid/product-card"
          data-editable="array-item"
          {...product}
          photos={productPhotos(product)}
          showPhotoGallery={showPhotoGallery}
          enquiryEmail={enquiryEmail}
          enquiryText={enquiryText}
          hidden={!visible.has(index)}
        />
      ))
    }
  </Grid>
  <Text
    class="product-grid-footnote"
    alignmentHorizontal={alignmentHorizontal}
    data-prop="footnote"
    text={footnote}
  />
  <ButtonGroup
    class="product-grid-buttons"
    buttonSections={buttonSections}
    alignmentHorizontal={alignmentHorizontal}
    data-children-prop="buttonSections"
  />
</CustomSection>

{isRotating && <ProductRotationScript />}
{hasPhotoGallery && <ProductGalleryScript />}

<style is:global>
  @layer page-sections {
    .product-grid-subtext {
      margin-inline: auto;
      max-width: 60ch;
    }

    .product-grid-grid {
      margin-top: var(--spacing-2xl);
    }

    .product-grid-buttons {
      margin-top: var(--spacing-xl);
    }

    .product-grid-footnote {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      margin-top: var(--spacing-xl);

      p {
        font-size: var(--font-size-sm);
      }
    }
  }
</style>
