---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Grid from "@wrappers/grid/Grid.astro";
import ProductCard from "./ProductCard.astro";

type ProductProps = Record<string, unknown>;

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  products = [],
  enquiryEmail = "",
  enquiryText = "enquire",
  footnote = "",
  buttonSections = [],
  minItemWidth = 260,
  maxItemWidth = 340,
  gap = "lg",
  alignmentHorizontal = "center",
  sectionLabel,
  maxContentWidth = "2xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["product-grid", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  background={background}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal={alignmentHorizontal}
    class="eyebrow"
    data-prop="eyebrow"
    text={eyebrow}
  />
  <Heading
    level="h2"
    size="lg"
    alignmentHorizontal={alignmentHorizontal}
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Text
    class="product-grid-subtext subtext"
    alignmentHorizontal={alignmentHorizontal}
    data-prop="subtext"
    text={subtext}
  />
  <Grid
    gap={gap}
    layout="start"
    minItemWidth={minItemWidth}
    maxItemWidth={maxItemWidth}
    class="product-grid-grid"
    data-children-prop="products"
  >
    {
      products.map((product: ProductProps) => (
        <ProductCard
          data-id="page-sections/commerce/product-grid/product-card"
          data-editable="array-item"
          enquiryEmail={enquiryEmail}
          enquiryText={enquiryText}
          {...product}
        />
      ))
    }
  </Grid>
  <Text
    class="product-grid-footnote"
    alignmentHorizontal={alignmentHorizontal}
    data-prop="footnote"
    text={footnote}
  />
  <ButtonGroup
    class="product-grid-buttons"
    buttonSections={buttonSections}
    alignmentHorizontal={alignmentHorizontal}
    data-children-prop="buttonSections"
  />
</CustomSection>

<style is:global>
  @layer page-sections {
    .product-grid-subtext {
      margin-inline: auto;
      max-width: 60ch;
    }

    .product-grid-grid {
      margin-top: var(--spacing-2xl);
    }

    .product-grid-buttons {
      margin-top: var(--spacing-xl);
    }

    .product-grid-footnote {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      margin-top: var(--spacing-xl);

      p {
        font-size: var(--font-size-sm);
      }
    }
  }
</style>
