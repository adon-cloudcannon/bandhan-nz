---
import Button from "@core-elements/button/Button.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import seoData from "@data/seo.json";
import Page from "@layouts/Page.astro";

const canonical = new URL("/404.html", Astro.site ?? seoData.url).href;
---

<Page
  title="page not found"
  description="this page does not exist. head home, or have a browse of the shop instead."
  canonical={canonical}
  mainNav={mainNavData}
  footer={footerData}
>
  <section class="not-found">
    <h1>a loose thread</h1>
    <p>this page has wandered off, or never existed in the first place. no harm done.</p>
    <div class="not-found-actions">
      <Button
        text="back home"
        link="/"
        variant="primary"
        size="md"
        hideText={false}
        iconName=""
        iconPosition="before"
      />
      <Button
        text="see the shop"
        link="/shop/"
        variant="tertiary"
        size="md"
        hideText={false}
        iconName=""
        iconPosition="before"
      />
    </div>
  </section>
</Page>

<style>
  .not-found {
    box-sizing: border-box;
    margin-inline: auto;
    max-width: 36rem;
    padding: var(--spacing-4xl) var(--spacing-xl);
    text-align: center;
  }

  .not-found h1 {
    font-size: var(--font-size-3xl);
    margin: 0 0 var(--spacing-md);
  }

  .not-found p {
    color: var(--color-text-muted);
    margin: 0 0 var(--spacing-xl);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    justify-content: center;
  }
</style>
